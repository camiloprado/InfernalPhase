static func t(key: String) -> String:
	var table: Dictionary = PT if Game.locale != "en" else EN
	if table.has(key):
		return String(table[key])
	if EN.has(key):
		return String(EN[key])
	return key


static func who(id: String) -> String:
	var key := "who." + id
	if PT.has(key) or EN.has(key):
		return t(key)
	return id
