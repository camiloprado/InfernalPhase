; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Infernal Phase"
config/description="One infernal floor. Move, shoot, clear rooms, die, repeat."
config/version="1.0.0"
run/main_scene="res://scenes/floor.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.043, 0.047, 0.063, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/game.gd"
Music="*res://scripts/music.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=768
window/size/window_width_override=1280
window/size/window_height_override=768
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="player_bullets"
2d_physics/layer_5="enemy_bullets"

[physics]

2d/default_gravity=0.0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.043, 0.047, 0.063, 1)
2d/snap/snap_2d_transforms_to_pixel=true
