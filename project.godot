; Engine configuration file.
; Infernal Phase — Godot 4.x
config_version=5

[application]

config/name="Infernal Phase"
config/description="One infernal floor. Move, shoot, clear rooms, die, repeat."
config/version="1.0.0"
run/main_scene="res://scenes/floor.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.047, 0.035, 0.043, 1)
boot_splash/show_image=false

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="player_bullets"
2d_physics/layer_5="enemy_bullets"

[physics]

2d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.047, 0.035, 0.043, 1)
2d/snap/snap_2d_transforms_to_pixel=true
